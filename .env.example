# Brandcast Flow — variáveis para docker compose
# Copie para .env (não commitar) e preencha os valores reais antes de subir
# o stack: `cp .env.example .env`

# ============================================================================
# Banco
# ============================================================================
POSTGRES_USER=brandcast
POSTGRES_PASSWORD=brandcast_dev
POSTGRES_DB=brandcast
POSTGRES_PORT=5432

# ============================================================================
# Redis (cache + fila de publicação)
# ============================================================================
REDIS_PASSWORD=brandcast_dev
REDIS_PORT=6379

# ============================================================================
# Backend (FastAPI)
# ============================================================================
BACKEND_PORT=8000
ENVIRONMENT=development
# Gere com: openssl rand -base64 32
JWT_SECRET=change-me-openssl-rand-base64-32
# Origins permitidas (separadas por vírgula) — backend usa para CORS
CORS_ORIGINS=http://localhost:5173

# ============================================================================
# Frontend (Vite + nginx)
# ============================================================================
FRONTEND_PORT=5173

# ============================================================================
# OAuth Meta — https://developers.facebook.com/apps
# ============================================================================
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback

# ============================================================================
# OAuth Google + Google Ads — https://console.cloud.google.com
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Token de desenvolvedor da Google Ads API (precisa de aprovação)
GOOGLE_ADS_DEVELOPER_TOKEN=
